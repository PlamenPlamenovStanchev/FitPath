# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Browser-safe Clerk configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Optional browser API origin.
# Leave empty during local development to use Vite's /api proxy.
VITE_API_URL=

# Server-only Clerk configuration
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=REPLACE_ME
R2_ENDPOINT=https://REPLACE_ME.r2.cloudflarestorage.com
