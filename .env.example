# DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# CLERK
# This publishable key is safe for the browser. Keep the secret key server-only.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# R2
# Operational bucket: keep private and use server-only credentials.
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=REPLACE_ME
R2_ENDPOINT=https://REPLACE_ME.r2.cloudflarestorage.com

# Backup R2: a separate private bucket and separate credentials. The backup
# writer needs access only to this bucket; never reuse operational R2 keys.
BACKUP_R2_ACCESS_KEY_ID=REPLACE_ME
BACKUP_R2_SECRET_ACCESS_KEY=REPLACE_ME
BACKUP_R2_BUCKET_NAME=REPLACE_ME
BACKUP_R2_ENDPOINT=https://REPLACE_ME.r2.cloudflarestorage.com

# Restore target R2: non-production only, with dedicated write credentials.
RESTORE_R2_ACCESS_KEY_ID=REPLACE_ME
RESTORE_R2_SECRET_ACCESS_KEY=REPLACE_ME
RESTORE_R2_BUCKET_NAME=REPLACE_ME
RESTORE_R2_ENDPOINT=https://REPLACE_ME.r2.cloudflarestorage.com

# CLIENT
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Leave empty during local development to use Vite's /api proxy.
VITE_API_URL=

# TESTING
# Keep Cypress credentials in ignored cypress.env.json. The manual E2E workflow
# reads its dedicated test configuration from GitHub Secrets.
