{
  "name": "fitpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names client,server --prefix-colors cyan,magenta \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test:unit": "node --test client/src/utils/bmi.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "cypress open",
    "e2e:run": "cypress run",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:studio": "npm run db:studio --workspace server"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.53",
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "cypress": "^15.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
